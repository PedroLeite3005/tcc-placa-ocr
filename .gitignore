# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.vscode

# Ambientes virtuais
.venv/
venv/
env/

# Datasets (não versionar)
bj7/
bj7_old/
rodosol/

# Exceção: split.txt do BJ7 (leve, define os splits train/val/test —
# necessário na Jetson para montar o dataset de teste sem levar as imagens todas)
!bj7/split.txt

# Checkpoints (pesados) — nunca versionar; transferir via rsync/scp (ver sync_jetson.sh)
logs/**/*.pt

# Modelos exportados (ONNX) e motores TensorRT — gerados por export_onnx.py /
# build_trt_engines.sh; os motores só servem na GPU onde foram compilados
logs/onnx/
logs/trt/*.engine