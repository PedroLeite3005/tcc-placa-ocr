# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Ambientes virtuais
.venv/
venv/
env/

# Datasets (não versionar)
bj7/
bj7_old/
rodosol/

# Exceção: split.txt do BJ7 (leve, define os splits train/val/test —
# necessário na Jetson para montar o dataset de teste sem levar as imagens todas)
!bj7/split.txt

# Checkpoints (pesados) — manter só logs em texto se quiser versionar
logs/**/*.pt

# Exceção: checkpoint do CRNN (mais leve) versionado para uso direto na Jetson
!logs/bj7_crnn/bj7_crnn_best.pt

!bj7/split.txt